  },
  "dependencies": {
    "@dialect/core": "0.1.0",
    "@dialect/platform-iosxe": "0.1.0",
    "@dialect/platform-iosxr": "0.1.0",
    "@dialect/platform-junos": "0.1.0",
    "@dialect/platform-nxos": "0.1.0"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6",
    "vite": "^8.3.4"
  }
}
