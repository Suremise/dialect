{
  "modelVersion": "0.5.3",
  "device": {
    "system": {
      "hostname": "xr-ipv6-access-list"
    },
    "filters": {
      "ipv6": {
        "acl_ipv6": {
          "implicitAction": "deny",
          "terms": {
            "10": {
              "matches": {
                "destinationPrefixes": [
                  "::1/128"
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "20": {
              "matches": {
                "destinationPrefixes": [
                  "dead:beef::/32"
                ]
              },
              "actions": {
                "action": "discard"
              }
            },
            "30": {
              "actions": {
                "action": "accept"
              }
            }
          }
        },
        "acl_remark": {
          "implicitAction": "deny"
        }
      }
    }
  }
}
