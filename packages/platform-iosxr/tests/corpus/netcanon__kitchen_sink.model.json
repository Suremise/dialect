{
  "modelVersion": "0.5.4",
  "device": {
    "system": {
      "hostname": "xr-kitchensink",
      "domainName": "lab.example.net"
    },
    "networkInstances": {
      "CUSTOMER-A": {
        "type": "vrf",
        "bgp": {
          "localAs": 65001
        },
        "routeDistinguisher": "65001:100",
        "staticRoutes": {
          "10.99.0.0/16": {
            "nextHops": {
              "0": {
                "address": "203.0.113.2"
              }
            }
          }
        },
        "routeTargets": {
          "import": [
            "65001:100"
          ],
          "export": [
            "65001:100"
          ]
        }
      },
      "MGMT": {
        "type": "vrf",
        "bgp": {
          "localAs": 65001
        },
        "routeDistinguisher": "65001:999",
        "routeTargets": {
          "import": [
            "65001:999"
          ],
          "export": [
            "65001:999"
          ]
        }
      },
      "default": {
        "bgp": {
          "localAs": 65001,
          "routerId": "10.255.0.1"
        },
        "staticRoutes": {
          "0.0.0.0/0": {
            "nextHops": {
              "0": {
                "address": "198.51.100.2"
              }
            }
          },
          "10.50.0.0/16": {
            "nextHops": {
              "0": {
                "interface": "GigabitEthernet0/0/0/1",
                "address": "203.0.113.2"
              }
            }
          },
          "192.0.2.0/24": {
            "nextHops": {
              "0": {
                "drop": "discard"
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "Loopback0": {
        "type": "loopback",
        "description": "router-id loopback",
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "10.255.0.1": {
                  "prefixLength": 32
                }
              }
            }
          }
        }
      },
      "GigabitEthernet0/0/0/0": {
        "type": "ethernet",
        "description": "core uplink to P1",
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "198.51.100.1": {
                  "prefixLength": 30
                }
              }
            },
            "ipv6": {
              "addresses": {
                "2001:db8:ff::1": {
                  "prefixLength": 64
                }
              }
            }
          }
        },
        "mtu": 9192
      },
      "GigabitEthernet0/0/0/1": {
        "type": "ethernet",
        "description": "customer handoff",
        "subinterfaces": {
          "0": {
            "networkInstance": "CUSTOMER-A",
            "ipv4": {
              "addresses": {
                "203.0.113.1": {
                  "prefixLength": 24
                }
              }
            }
          },
          "100": {
            "description": "customer vlan 100 subif",
            "networkInstance": "CUSTOMER-A",
            "vlanId": 100,
            "ipv4": {
              "addresses": {
                "203.0.113.129": {
                  "prefixLength": 25
                }
              }
            }
          }
        },
        "vlanTagging": true
      },
      "GigabitEthernet0/0/0/3": {
        "type": "ethernet",
        "description": "bundle member one",
        "aggregate": "Bundle-Ether1"
      },
      "GigabitEthernet0/0/0/4": {
        "type": "ethernet",
        "description": "bundle member two",
        "aggregate": "Bundle-Ether1"
      },
      "TenGigE0/0/0/2": {
        "type": "ethernet",
        "enabled": false
      },
      "Bundle-Ether1": {
        "type": "aggregate",
        "description": "backbone bundle",
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "10.0.0.1": {
                  "prefixLength": 31
                }
              }
            }
          }
        },
        "aggregation": {
          "lacp": "active"
        }
      },
      "MgmtEth0/RP0/CPU0/0": {
        "type": "management",
        "subinterfaces": {
          "0": {
            "networkInstance": "MGMT",
            "ipv4": {
              "addresses": {
                "192.168.0.1": {
                  "prefixLength": 24
                }
              }
            }
          }
        }
      }
    }
  }
}
