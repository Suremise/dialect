{
  "modelVersion": "0.5.3",
  "device": {
    "system": {
      "hostname": "pe1"
    },
    "interfaces": {
      "GigabitEthernet0/0/0/0": {
        "type": "ethernet",
        "subinterfaces": {
          "0": {
            "ipv4": {
