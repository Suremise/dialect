                  "198.51.100.1/32"
                ],
                "destinationPorts": [
                  "22"
                ]
              },
              "actions": {
                "action": "accept",
                "log": true
              }
            },
            "30": {
              "matches": {
                "protocols": [
                  6
                ],
                "destinationPrefixes": [
                  "198.51.100.0/24"
                ],
                "destinationPorts": [
                  "8080-8090"
                ],
                "tcpEstablished": true
              },
              "actions": {
                "action": "accept"
              }
            },
            "40": {
              "matches": {
                "protocols": [
                  17
                ],
                "sourcePorts": [
                  "53"
                ],
                "destinationPorts": [
                  "1024-65535"
                ]
              },
              "actions": {
                "action": "accept",
                "count": "DNS"
              }
            },
            "50": {
              "matches": {
                "protocols": [
                  1
                ],
                "icmpTypes": [
                  8
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "60": {
              "matches": {
                "protocols": [
                  1
                ],
                "icmpTypes": [
                  3
                ],
                "icmpCodes": [
                  4
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "70": {
              "matches": {
                "sourcePrefixes": [
                  "10.0.0.0/8"
                ],
                "fragment": "non-initial"
              },
              "actions": {
                "action": "discard"
              }
            },
            "80": {
              "matches": {
                "protocols": [
                  6
                ],
                "destinationPorts": [
                  "0-1023"
                ],
                "dscp": [
                  10
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "90": {
              "matches": {
                "protocols": [
                  89
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "100": {
              "actions": {
                "action": "discard",
                "log": true
