        },
        "EMPTY": {
          "implicitAction": "deny"
        }
      },
      "ipv6": {
        "EDGE6-IN": {
          "implicitAction": "deny",
          "terms": {
            "10": {
              "matches": {
                "protocols": [
                  6
                ],
                "destinationPrefixes": [
                  "2001:db8::/32"
                ],
                "destinationPorts": [
                  "80"
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "20": {
              "matches": {
                "protocols": [
                  58
                ],
                "icmpTypes": [
                  2
                ]
              },
              "actions": {
