      "TenGigabitEthernet1/0/4": {
        "type": "ethernet",
        "description": "Server bond member (Po2)",
        "switching": {
          "mode": "trunk",
          "allowedVlans": [
            "20"
          ]
        },
        "enabled": true
      },
      "TenGigabitEthernet1/0/5": {
        "type": "ethernet",
        "description": "Disabled spare port",
        "enabled": false
      },
      "Vlan10": {
        "type": "irb-or-svi",
        "subinterfaces": {
          "0": {
            "routedVlan": 10,
            "ipv4": {
              "addresses": {
                "192.168.10.1": {
                  "prefixLength": 24
                }
              }
            },
            "ipv6": {
              "addresses": {
                "2001:db8:10::1": {
                  "prefixLength": 64
                }
              }
            }
          }
        },
        "description": "Users SVI"
      },
      "Vlan20": {
        "type": "irb-or-svi",
        "subinterfaces": {
          "0": {
            "routedVlan": 20,
            "ipv4": {
              "addresses": {
                "192.168.20.1": {
                  "prefixLength": 24
                }
              }
            }
          }
        },
        "description": "Servers SVI"
      },
      "Vlan30": {
        "type": "irb-or-svi",
        "subinterfaces": {
