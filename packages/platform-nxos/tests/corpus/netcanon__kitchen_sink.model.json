{
  "modelVersion": "0.3.0",
  "device": {
    "system": {
      "hostname": "nxos-kitchensink",
      "snmp": {
        "communities": {
          "public-ro": {}
        },
        "location": "DataCenter-1-RackB",
        "contact": "netops@example.net"
      }
    },
    "networkInstances": {
      "management": {
        "type": "vrf"
      },
      "TENANT-A": {
        "type": "vrf",
        "routeDistinguisher": "65001:100",
        "staticRoutes": {
          "10.50.0.0/16": {
            "nextHops": {
              "0": {
                "address": "172.16.0.2"
              }
            }
          }
        },
        "routeTargets": {
          "import": [
            "65001:100"
          ],
          "export": [
            "65001:100"
          ]
        }
      },
      "default": {
        "staticRoutes": {
          "0.0.0.0/0": {
            "nextHops": {
              "0": {
                "address": "192.0.2.254"
              }
            }
          },
          "10.100.0.0/16": {
            "nextHops": {
              "0": {
                "address": "192.0.2.253",
                "preference": 200
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "Vlan10": {
        "type": "vlan",
        "description": "PROD gateway SVI",
        "enabled": true,
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "10.10.10.1": {
                  "prefixLength": 24
                }
              }
            }
          }
        }
      },
      "Vlan20": {
        "type": "vlan",
        "description": "tenant-a anycast gateway SVI",
        "enabled": true,
        "subinterfaces": {
          "0": {
            "networkInstance": "TENANT-A",
            "ipv4": {
              "addresses": {
                "10.20.20.1": {
                  "prefixLength": 24
                }
              }
            }
          }
        }
      },
      "port-channel1": {
        "type": "aggregate",
        "description": "uplink bundle"
      },
      "Ethernet1/1": {
        "type": "ethernet",
        "description": "routed uplink to spine",
        "enabled": true,
        "mtu": 9216,
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "192.0.2.1": {
                  "prefixLength": 31
                }
              }
            }
          }
        }
      },
      "Ethernet1/2": {
        "type": "ethernet",
        "description": "tenant-a routed port",
        "enabled": true,
        "subinterfaces": {
          "0": {
            "networkInstance": "TENANT-A",
            "ipv4": {
              "addresses": {
                "172.16.0.1": {
                  "prefixLength": 30
                }
              }
            },
            "ipv6": {
              "addresses": {
                "2001:db8:a::1": {
                  "prefixLength": 64
                }
              }
            }
          }
        }
      },
      "Ethernet1/3": {
        "type": "ethernet",
        "description": "access port"
      },
      "Ethernet1/4": {
        "type": "ethernet",
        "description": "trunk port"
      },
      "Ethernet1/5": {
        "type": "ethernet",
        "description": "bundle member"
      },
      "Ethernet1/6": {
        "type": "ethernet",
        "description": "bundle member"
      },
      "Ethernet1/7": {
        "type": "ethernet",
        "enabled": false
      },
      "loopback0": {
        "type": "loopback",
        "description": "router-id loopback",
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "10.255.0.1": {
                  "prefixLength": 32
                }
              }
            }
          }
        }
      },
      "mgmt0": {
        "type": "management",
        "subinterfaces": {
          "0": {
            "networkInstance": "management",
            "ipv4": {
              "addresses": {
                "192.0.2.10": {
                  "prefixLength": 24
                }
              }
            }
          }
        }
      },
      "nve1": {
        "enabled": true
      }
    }
  }
}
