{
  "modelVersion": "0.5.0",
  "device": {
    "networkInstances": {
      "default": {
        "bgp": {
          "localAs": 65000,
          "neighbors": {
            "198.51.100.2": {
              "peerAs": 65000,
              "importPolicies": ["FROM-PEER"],
              "exportPolicies": ["TO-PEER"],
              "addressFamilies": {
                "ipv4-unicast": {}
              }
            }
          }
        }
      }
    },
    "routingPolicy": {
      "prefixLists": {
        "ipv4": {
          "CUSTOMERS": { "entries": { "1": { "action": "permit", "prefix": "192.0.2.0/24", "minLength": 24, "maxLength": 32, "form": "orlonger" } } },
          "BOGONS": { "entries": { "1": { "action": "permit", "prefix": "10.0.0.0/8", "minLength": 8, "maxLength": 32, "form": "orlonger" } } }
        }
      },
      "policies": {
        "FROM-PEER": {
          "terms": {
            "1": { "name": "bogons", "matches": { "prefixLists": { "ipv4": ["BOGONS"] } }, "actions": { "flow": "reject" } },
            "2": { "name": "customers", "matches": { "prefixLists": { "ipv4": ["CUSTOMERS"] } }, "actions": { "flow": "accept", "localPreference": 200 } }
          },
          "fallThrough": "next-policy"
        },
        "TO-PEER": {
          "terms": {
            "1": { "name": "customers", "matches": { "prefixLists": { "ipv4": ["CUSTOMERS"] } }, "actions": { "flow": "accept" } },
            "2": { "name": "rest", "actions": { "flow": "reject" } }
          },
          "fallThrough": "next-policy"
        }
      }
    }
  }
}