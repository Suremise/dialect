            "20": {
              "matches": {
                "protocols": [
                  6
                ],
                "sourcePrefixes": [
                  "2001:db8::/32"
                ],
                "destinationPrefixes": [
                  "2001:db8:1::1/128"
                ],
                "destinationPorts": [
                  "22"
                ]
              },
              "actions": {
                "action": "accept"
              }
            },
            "30": {
              "actions": {
                "action": "discard",
                "log": true
              }
            }
          },
          "implicitAction": "deny"
        }
      }
