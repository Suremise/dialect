{
  "modelVersion": "0.5.3",
  "device": {
    "system": {
      "hostname": "leaf-4"
    },
    "interfaces": {
      "Ethernet1/1": {
        "type": "ethernet",
        "subinterfaces": {
          "0": {
            "ipv4": {
              "addresses": {
                "198.51.100.1": {
                  "prefixLength": 30
                }
              }
            },
            "ipv6": {
              "addresses": {
                "2001:db8:1::1": {
                  "prefixLength": 64
                }
              }
            },
            "filters": {
