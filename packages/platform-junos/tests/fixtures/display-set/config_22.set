set version 14.1R5.4
set groups sp-address-family interfaces <*> unit <*> family inet6
set groups sp-address-family interfaces <*> unit <*> family mpls
set groups static-reject logical-systems <*> routing-instances <*> routing-options rib <*> static route <*> reject
set groups mtu logical-systems <*> interfaces <ge-*> unit <*> family inet mtu 1500
set groups mtu logical-systems <*> interfaces <ge-*> unit <*> family inet6 mtu 1500
set apply-groups mtu
set system host-name vMX01
set system root-authentication encrypted-password "$1$PLACEHOLDER"
set system login user play uid 9999
set system login user play class super-user
set system login user play authentication encrypted-password "$1$PLACEHOLDER"
set system services ftp
set system services ssh root-login allow
set system services telnet
set system syslog user * any emergency
set system syslog file messages any notice
set system syslog file messages authorization info
set system syslog file interactive-commands interactive-commands any
