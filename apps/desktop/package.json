{
  "name": "@dialect/desktop",
  "version": "0.0.0",
  "description": "The Tauri 2 desktop shell: windows, file dialogs and file access around the shared UI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "build:app": "tauri build --no-bundle",
    "build:installers": "node scripts/build-installers.mjs",
    "frontend": "vite build",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@dialect/ui": "0.0.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
