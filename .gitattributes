# Normalise text files to LF in the repo and in checkouts.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: no line-ending conversion or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.msi binary
*.dmg binary
*.wasm binary

# Two branches' new Unreleased entries both stay when they merge (as in Hive). Union keeps both versions of a changed
# line without warning, so use it for nothing else.
CHANGELOG.md merge=union
